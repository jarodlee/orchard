From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "Jarod Lee (MacMini)" <lee.jarod@gmail.com>
Date: Wed, 4 Nov 2026 09:20:05 +0800
Subject: [PATCH] power: supply: apple_tristar_charger: reidentify after a
 transient input

A J71b wall-charger run observed status 0x42 -> 0x62 -> 0x42 within
104 ms. The poll withdrew the 2400 mA grant on 0x62, but left the phase
CHARGING and the target intact. After status returned to 0x42 there was
no source epoch or line withdrawal to rearm the ramp. The input remained
at 500 mA while CURRENT_MAX still reported 2400 mA, sometimes draining
the battery even with the display off.

Remember a non-ready input and start a fresh attachment once it is ready
again. Invalidate any old USB current allowance, retaining the USB data
session marker. This keeps the existing strict status check, source
identification, board maximum and battery ramp checks; it does not raise
a current based only on a cached source. Repeated non-ready reads do not
restart identification, and latched faults remain latched.

Signed-off-by: Jarod Lee (MacMini) <lee.jarod@gmail.com>
---
 drivers/power/supply/apple_tristar_charger.c | 30 ++++++++++++++++----
 1 file changed, 25 insertions(+), 5 deletions(-)

diff --git a/drivers/power/supply/apple_tristar_charger.c b/drivers/power/supply/apple_tristar_charger.c
index 3b53fe1..6c19dcf 100644
--- a/drivers/power/supply/apple_tristar_charger.c
+++ b/drivers/power/supply/apple_tristar_charger.c
@@ -136,6 +136,7 @@ struct tristar_charger {
 	enum tristar_phase phase;
 	bool online;
 	bool present;
+	bool input_unstable;
 	bool stopping;
 	unsigned int code;	/* last verified input limit */
 	unsigned int target_code;
@@ -670,6 +671,7 @@ static void tristar_update_target(struct tristar_charger *chg)
 static void tristar_new_attachment(struct tristar_charger *chg, u64 now)
 {
 	chg->present = true;
+	chg->input_unstable = false;
 	chg->phase = TRISTAR_SETTLING;
 	chg->attach_ns = now;
 	chg->source[0] = '\0';
@@ -862,6 +864,28 @@ static void tristar_guard(struct tristar_charger *chg, u64 now)
 	}
 }
 
+/*
+ * A non-ready input must lose its grant. Once it is ready again, identify
+ * it afresh: the old allowance may belong to a source replaced during the
+ * transient. Keep the USB session marker so identification cannot disturb
+ * live data lines, but invalidate that session's previous current grant.
+ * Caller holds lock; a latched fault must remain latched.
+ */
+static bool tristar_input_ready(struct tristar_charger *chg, unsigned int status,
+			       u64 now)
+{
+	if (status != TRISTAR_CHG_STATUS_ONLINE) {
+		tristar_withdraw(chg, TRISTAR_CHG_FALLBACK_CODE);
+		chg->input_unstable = true;
+		return false;
+	}
+	if (!chg->input_unstable || !chg->present || chg->phase == TRISTAR_FAULT)
+		return true;
+	chg->usb_epoch = READ_ONCE(chg->epoch) - 1;
+	tristar_new_attachment(chg, now);
+	return false;
+}
+
 static void tristar_poll(struct work_struct *work)
 {
 	struct tristar_charger *chg = container_of(to_delayed_work(work),
@@ -895,12 +919,8 @@ static void tristar_poll(struct work_struct *work)
 		}
 		goto again;
 	}
-	if (status != TRISTAR_CHG_STATUS_ONLINE) {
-		/* Transitional input state (e.g. 0x40 while attaching): no grant. */
-		if (chg->code > TRISTAR_CHG_FALLBACK_CODE)
-			tristar_withdraw(chg, TRISTAR_CHG_FALLBACK_CODE);
+	if (!tristar_input_ready(chg, status, now))
 		goto again;
-	}
 	if (!chg->present) {
 		tristar_new_attachment(chg, now);
 		goto again;
-- 
